{
  "name": "remotion-ai-science",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "check:captions": "node scripts/check-captions.mjs",
    "prepare:episode": "python scripts/prepare_episode.py",
    "render": "remotion render src/index.ts AiScience out/ai-coding-v1.mp4 --codec=h264 --crf=18 --concurrency=4",
    "still": "remotion still src/index.ts AiScience out/cover.png --frame=60",
    "check:components": "node scripts/verify-community.mjs",
    "catalog:components": "node scripts/build-component-catalog.mjs",
    "generate:contracts": "node scripts/run-python.mjs scripts/export-contracts.py",
    "check:contracts": "node scripts/run-python.mjs scripts/export-contracts.py --check",
    "generate:component-entrypoints": "node scripts/generate-component-entrypoints.mjs",
    "generate:production-components": "node scripts/build-production-component-manifest.mjs",
    "check:production-components": "node scripts/build-production-component-manifest.mjs --check",
    "generate:native-components": "node scripts/build-native-component-capabilities.mjs",
    "check:native-components": "node scripts/build-native-component-capabilities.mjs --check",
    "check:component-paths": "node scripts/check-component-paths.mjs",
    "test:timeline": "node --test src/video-production/*.test.mjs",
    "test:python": "node scripts/run-python.mjs -m pytest tests/ -q",
    "check:all": "npm run check:contracts && npm run test:python && npm run typecheck && npm run test:timeline && npm run check:production-components && npm run check:component-paths && npm run lint"
  },
  "dependencies": {
    "@remotion/captions": "4.0.532",
    "@remotion/media": "4.0.532",
    "@remotion/paths": "4.0.532",
    "@remotion/shapes": "4.0.532",
    "@remotion/transitions": "4.0.532",
    "culori": "4.0.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.532",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@remotion/bundler": "4.0.532",
    "@remotion/cli": "4.0.532",
    "@remotion/eslint-config-flat": "4.0.532",
    "@remotion/renderer": "4.0.532",
    "@types/culori": "4.0.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
